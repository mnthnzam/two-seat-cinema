{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "two-seat-cinema",
  "main": "src/index.js",
  "compatibility_date": "2026-06-01",
  // Only reachable on the Access-protected custom domain.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "movies.mnthn.com", "custom_domain": true, "zone_name": "mnthn.com" }],
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*", "/img"] },
  "d1_databases": [{ "binding": "DB", "database_name": "two-seat", "database_id": "872ccb06-5066-4b89-bfea-9a44ed56146c" }],
  "ai": { "binding": "AI" },
  "vars": {
    // Fill these after setting up Access (see README): your team domain and the app's AUD tag.
    "ACCESS_TEAM_DOMAIN": "mnthn.cloudflareaccess.com",
    "ACCESS_AUD": "126ff33778032128aa558b7c5a131398df5d51e23b620161ffd344ac810774fa"
  },
  "observability": { "enabled": true }
}
